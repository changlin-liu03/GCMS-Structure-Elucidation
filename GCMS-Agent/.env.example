# Required only for real Agent/model calls; baseline and offline tests need no key.
# Copy this template to the repository-root .env, then replace the placeholder.
# If .env already exists, edit it instead of overwriting it.
# A nonempty DEEPSEEK_API_KEY in the process environment takes precedence.
# The project .env loader reads only this key; it does not expand shell variables.
# Keep one entry. Put comments on separate lines, not after the key value.
# Configure the model, API endpoint and optional cli_path in configs/model.yaml.
# Local .env files are Git-ignored; this template contains no real credentials.
DEEPSEEK_API_KEY=replace-with-your-key
